// ─── Scoring Models ───────────────────────────────────────────────────────────
// Org-level scoring model templates (RICE-style and similar), selected per
// workspace, scoring Opportunities only in v1. See lib/scoring.ts for the
// formula computation semantics. ADR context: Products/Compass/Brainstorm —
// Scoring Models for Discovery Objects — 2026-07-16.md.

model ScoringModel {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(255)
  description    String?  @db.Text
  /// One of: ACTIVE | ARCHIVED. Archived models are hidden from the workspace
  /// picker for new selections but remain valid for workspaces already using
  /// them and for existing OpportunityScore history.
  status         String   @default("ACTIVE") @db.VarChar(50)
  /// One of: WEIGHTED_SUM | MULTIPLICATIVE. See lib/scoring.ts for the
  /// computation semantics of each.
  formulaType    String   @default("WEIGHTED_SUM") @map("formula_type") @db.VarChar(50)
  /// Bumped by app code (not a DB trigger) whenever the metrics array
  /// changes shape/weights — never on name/description-only edits. Snapshotted
  /// onto every OpportunityScore at scoring time so historical scores are
  /// self-describing even after the live model changes.
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  organization     Organization             @relation(fields: [organizationId], references: [id])
  metrics          ScoringModelMetric[]
  workspaceConfigs WorkspaceScoringConfig[]
  scores           OpportunityScore[]

  @@index([organizationId])
  @@map("scoring_models")
}

model ScoringModelMetric {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scoringModelId String  @map("scoring_model_id") @db.Uuid
  /// Stable machine key referenced in OpportunityScore.rawValues JSON,
  /// e.g. "reach", "impact", "effort". Immutable after creation in practice
  /// (changing it orphans historical rawValues keys) — enforced in the UI by
  /// not allowing key edits after first save, only add/remove/reweight.
  key            String  @db.VarChar(50)
  label          String  @db.VarChar(255)
  description    String? @db.Text
  minValue       Float   @default(0) @map("min_value")
  maxValue       Float   @default(10) @map("max_value")
  /// Scalar multiplier applied to the raw input value before it enters the
  /// formula. Default 1 = faithful classic RICE/ICE (no extra weighting).
  weight         Float   @default(1)
  /// POSITIVE = this metric increases the score (added in WEIGHTED_SUM,
  /// multiplied into the numerator in MULTIPLICATIVE, e.g. Reach/Impact/
  /// Confidence). NEGATIVE = this metric decreases the score (subtracted in
  /// WEIGHTED_SUM, divided into the denominator in MULTIPLICATIVE, e.g.
  /// Effort). This one field drives both formula types — see lib/scoring.ts.
  direction      String  @default("POSITIVE") @db.VarChar(10)
  order          Int     @default(0)

  scoringModel ScoringModel @relation(fields: [scoringModelId], references: [id])

  @@unique([scoringModelId, key])
  @@map("scoring_model_metrics")
}

model WorkspaceScoringConfig {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String   @unique @map("workspace_id") @db.Uuid
  scoringModelId String?  @map("scoring_model_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  scoringModel ScoringModel? @relation(fields: [scoringModelId], references: [id])

  @@map("workspace_scoring_configs")
}

model OpportunityScore {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunityId   String   @unique @map("opportunity_id") @db.Uuid
  scoringModelId  String   @map("scoring_model_id") @db.Uuid
  /// ScoringModel.version at the moment this score was computed. If this no
  /// longer matches the live ScoringModel.version, the UI shows a
  /// "scored under an earlier version" banner rather than silently
  /// recomputing (opt-in re-score, per the versioning decision).
  modelVersion    Int      @map("model_version")
  /// Snapshot of the metric definitions (key/label/min/max/weight/direction)
  /// used to compute this score, so history survives future template edits
  /// without needing a fully versioned ScoringModelMetric table.
  formulaSnapshot Json     @map("formula_snapshot")
  /// { [metricKey]: number } — the raw input values as entered.
  rawValues       Json     @map("raw_values")
  rawScore        Float    @map("raw_score")
  /// 0-100, comparable across workspaces/templates. This is what any
  /// cross-workspace "top opportunities" view sorts on.
  normalizedScore Float    @map("normalized_score")
  scoredAt        DateTime @default(now()) @map("scored_at")
  scoredByUserId  String?  @map("scored_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")

  opportunity  Opportunity  @relation(fields: [opportunityId], references: [id])
  scoringModel ScoringModel @relation(fields: [scoringModelId], references: [id])

  @@index([scoringModelId])
  @@map("opportunity_scores")
}

// ─── Experiments ──────────────────────────────────────────────────────────────

model Experiment {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String             @map("workspace_id") @db.Uuid
  squadId       String?            @map("squad_id") @db.Uuid
  assumptionId  String?            @map("assumption_id") @db.Uuid
  title         String             @db.VarChar(255)
  hypothesis    String             @db.Text
  method        String             @db.Text
  killCondition String             @map("kill_condition") @db.Text
  status        String             @default("DESIGNING") @db.VarChar(50)
  sortOrder     Int                @default(0) @map("sort_order")
  startDate     DateTime?          @map("start_date")
  endDate       DateTime?          @map("end_date")
  conclusion    String?            @db.VarChar(50)
  /// Human-provided rationale behind `conclusion`. Not backed by evidence for
  /// NOT_PURSUED (a deliberate decision not to run the experiment) — durable
  /// record of "why" so it's visible on the experiment, not just in someone's
  /// memory. Optional for PROCEED/KILL/ITERATE; required by app code for
  /// NOT_PURSUED. See app/[orgSlug]/[workspaceSlug]/experiments/actions.ts.
  conclusionReason String?         @map("conclusion_reason") @db.Text
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @default(now()) @map("updated_at")
  workspace     Workspace          @relation(fields: [workspaceId], references: [id])
  squad         Squad?             @relation(fields: [squadId], references: [id])
  assumption    Assumption?        @relation(fields: [assumptionId], references: [id])
  results       ExperimentResult[]
  roadmapItems  RoadmapItem[]
  createdById   String?            @map("created_by_id") @db.Uuid
  updatedById   String?            @map("updated_by_id") @db.Uuid
  source        String             @default("UI") @map("source") @db.VarChar(20)

  @@map("experiments")
}

model ExperimentResult {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experimentId String     @map("experiment_id") @db.Uuid
  note         String     @db.Text
  metric       String?    @db.VarChar(255)
  value        Float?
  createdAt    DateTime   @default(now()) @map("created_at")
  experiment   Experiment @relation(fields: [experimentId], references: [id])
  createdById  String?    @map("created_by_id") @db.Uuid
  updatedById  String?    @map("updated_by_id") @db.Uuid
  source       String     @default("UI") @map("source") @db.VarChar(20)

  @@map("experiment_results")
}

