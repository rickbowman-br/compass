// Artifact links are resolved in application code because ArtifactLink is a
// deliberately polymorphic link table (SOLUTION and REVIEW_REQUEST targets).

model SolutionComment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  solutionId  String   @map("solution_id") @db.Uuid
  /// One of: PLAN | COMMENT
  commentType String   @default("COMMENT") @map("comment_type") @db.VarChar(20)
  body        String   @db.Text
  authorName  String   @map("author_name") @db.VarChar(255)
  /// One of: AGENT | HUMAN
  authorType  String   @default("HUMAN") @map("author_type") @db.VarChar(20)
  /// One of: UI | MCP
  source      String   @default("UI") @db.VarChar(20)
  /// One of: PENDING | APPROVED | REJECTED. Only meaningful on PLAN entries
  /// (always PENDING on COMMENT rows — approval applies to plans, not
  /// replies). Purely a status marker: approving/rejecting a plan has no
  /// side effects on the parent Solution's status.
  planStatus  String   @default("PENDING") @map("plan_status") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  solution    Solution @relation(fields: [solutionId], references: [id])

  @@map("solution_comments")
}

/// Shared mutable discussion record. targetType + targetId is deliberately
/// polymorphic; lib/comments.ts is the single referential-integrity boundary.
/// Aurora DSQL runs with relationMode=prisma, so delete ordering is explicit.
model Comment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  targetType String   @map("target_type") @db.VarChar(40)
  targetId   String   @map("target_id") @db.Uuid
  parentId   String?  @map("parent_id") @db.Uuid
  body       String   @db.Text
  status     String   @default("OPEN") @db.VarChar(20)
  authorId   String?  @map("author_id") @db.Uuid
  authorName String   @map("author_name") @db.VarChar(255)
  authorType String   @default("HUMAN") @map("author_type") @db.VarChar(20)
  source     String   @default("UI") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  parent Comment? @relation("SharedCommentReplies", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replies Comment[] @relation("SharedCommentReplies")
  docAnchor DocCommentAnchor?
  solutionPlanProposal SolutionPlanProposal?
  elementAnchor CommentElementAnchor?
  externalAuthor CommentExternalAuthor?

  @@index([workspaceId, targetType, targetId, status], map: "idx_comments_target_status")
  @@index([parentId], map: "idx_comments_parent")
  @@map("comments")
}

model DocCommentAnchor {
  commentId    String  @id @map("comment_id") @db.Uuid
  anchorText   String  @map("anchor_text") @db.Text
  anchorPrefix String? @map("anchor_prefix") @db.VarChar(100)
  anchorSuffix String? @map("anchor_suffix") @db.VarChar(100)
  anchorStart  Int?    @map("anchor_start")
  anchorEnd    Int?    @map("anchor_end")
  comment      Comment @relation(fields: [commentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("doc_comment_anchors")
}

model SolutionPlanProposal {
  commentId                String  @id @map("comment_id") @db.Uuid
  trackedDecisionRequestId String? @map("tracked_decision_request_id") @db.Uuid
  legacyPlanStatus         String? @map("legacy_plan_status") @db.VarChar(20)
  comment                  Comment @relation(fields: [commentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([trackedDecisionRequestId], map: "idx_solution_plan_proposals_decision")
  @@map("solution_plan_proposals")
}

/// Third 1:1 extension on Comment, alongside DocCommentAnchor and
/// SolutionPlanProposal: where on a rendered page the comment was left.
/// Created by an embedded feedback widget against an Artifact-bound
/// FeedbackSource, so `artifactId` is non-null BY CONSTRUCTION — it is written
/// only on comments whose targetType is ARTIFACT, and it always equals the
/// parent Comment's targetId. Kept as its own column anyway so the anchor row
/// can be indexed and queried without a join back through the polymorphic
/// target pair.
///
/// `artifactRevisionId` records WHICH revision was on screen when the comment
/// was left. It is provenance, not scope: a comment does not stop applying when
/// the artifact is revised, so nothing filters on it.
model CommentElementAnchor {
  commentId          String   @id @map("comment_id") @db.Uuid
  artifactId         String   @map("artifact_id") @db.Uuid
  artifactRevisionId String?  @map("artifact_revision_id") @db.Uuid
  pageUrl            String   @map("page_url") @db.Text
  pagePath           String   @map("page_path") @db.Text
  elementSelector    String?  @map("element_selector") @db.Text
  /// { tag, text, rectXRatio, rectYRatio, rectWRatio, rectHRatio } — ratios are
  /// DOCUMENT-relative, never viewport-relative, so a re-anchor attempt does not
  /// depend on the reader's scroll position or window size.
  elementFingerprint Json?    @map("element_fingerprint")
  /// Vercel Blob URL of the element screenshot the widget captured, or null.
  /// Evidence for a human reading the thread, never an input to re-anchoring —
  /// elementSelector and elementFingerprint do that work. Always null for
  /// comments made inside Compass, where the reviewer is already looking at the
  /// artifact.
  screenshotUrl      String?  @map("screenshot_url") @db.Text
  comment            Comment  @relation(fields: [commentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([artifactId, pageUrl], map: "idx_comment_element_anchors_artifact_page")
  @@map("comment_element_anchors")
}

/// Identity extension for a Comment whose author is not a Compass User.
///
/// Comment.authorId is a User FK, so a comment submitted through an embedded
/// widget by someone outside the organization has to leave it null. That loses
/// the submitter entirely. This table carries whatever identity the submission
/// did have — a typed email, a signed-in PortalAccount, or nothing but the
/// embed token that carried it — without widening Comment for a case most
/// comments do not have.
model CommentExternalAuthor {
  commentId       String         @id @map("comment_id") @db.Uuid
  submitterEmail  String?        @map("submitter_email") @db.VarChar(255)
  portalAccountId String?        @map("portal_account_id") @db.Uuid
  embedTokenId    String?        @map("embed_token_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  comment         Comment        @relation(fields: [commentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  portalAccount   PortalAccount? @relation(fields: [portalAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([portalAccountId], map: "idx_comment_external_authors_account")
  @@map("comment_external_authors")
}

model Assumption {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  solutionId  String       @map("solution_id") @db.Uuid
  title       String       @db.VarChar(255)
  description String?      @db.Text
