// ─── Release authorization ledger ──────────────────────────────────────────
// This is the normalized authorization/outbox slice from ADR-0005. Provider
// evidence and merge/deploy/verification state are intentionally deferred;
// creating a ReleaseDispatch never invokes external release automation.

model ReleaseRun {
  id                            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId                   String            @map("workspace_id") @db.Uuid
  provider                      String            @default("GITHUB") @db.VarChar(30)
  repositoryOwner               String            @map("repository_owner") @db.VarChar(255)
  repositoryName                String            @map("repository_name") @db.VarChar(255)
  pullRequestNumber             Int               @map("pull_request_number")
  baseRef                       String            @map("base_ref") @db.VarChar(255)
  headSha                       String            @map("head_sha") @db.Char(40)
  targetEnvironment             String            @default("PRODUCTION") @map("target_environment") @db.VarChar(30)
  releasePolicyId               String            @map("release_policy_id") @db.VarChar(160)
  sourceFingerprint             String            @map("source_fingerprint") @db.Char(64)
  state                         String            @default("PREPARING") @db.VarChar(30)
  authorizationDecisionRecordId String?           @unique(map: "idx_release_runs_authorization_decision") @map("authorization_decision_record_id") @db.Uuid
  version                       Int               @default(0)
  lastErrorCode                 String?           @map("last_error_code") @db.VarChar(100)
  lastError                     String?           @map("last_error") @db.Text
  createdById                   String?           @map("created_by_id") @db.Uuid
  createdAt                     DateTime          @default(now()) @map("created_at")
  updatedAt                     DateTime          @default(now()) @map("updated_at")
  workspace                     Workspace         @relation(fields: [workspaceId], references: [id])
  authorizationDecisionRecord   DecisionRecord?   @relation("ReleaseAuthorizationDecision", fields: [authorizationDecisionRecordId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tasks                         ReleaseRunTask[]
  dispatches                    ReleaseDispatch[]

  @@unique([workspaceId, provider, repositoryOwner, repositoryName, pullRequestNumber, sourceFingerprint], map: "idx_release_runs_scope_fingerprint")
  @@index([workspaceId, state, updatedAt], map: "idx_release_runs_workspace_state")
  @@index([provider, repositoryOwner, repositoryName, pullRequestNumber], map: "idx_release_runs_repository_pr")
  @@map("release_runs")
}

model ReleaseRunTask {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  releaseRunId String     @map("release_run_id") @db.Uuid
  taskId       String     @map("task_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  releaseRun   ReleaseRun @relation(fields: [releaseRunId], references: [id])
  task         Task       @relation(fields: [taskId], references: [id])

  @@unique([releaseRunId, taskId], map: "idx_release_run_tasks_run_task")
  @@index([taskId, releaseRunId], map: "idx_release_run_tasks_task_run")
  @@map("release_run_tasks")
}

model ReleaseDispatch {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  releaseRunId     String         @map("release_run_id") @db.Uuid
  decisionRecordId String         @map("decision_record_id") @db.Uuid
  continuationKey  String         @default("DISPATCH_RELEASE_RUN") @map("continuation_key") @db.VarChar(80)
  status           String         @default("PENDING") @db.VarChar(30)
  idempotencyKey   String         @unique(map: "idx_release_dispatches_idempotency") @map("idempotency_key") @db.VarChar(255)
  claimedBy        String?        @map("claimed_by") @db.VarChar(255)
  claimExpiresAt   DateTime?      @map("claim_expires_at")
  attemptCount     Int            @default(0) @map("attempt_count")
  version          Int            @default(0)
  runtimeRunId     String?        @map("runtime_run_id") @db.VarChar(255)
  lastError        String?        @map("last_error") @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @map("updated_at")
  completedAt      DateTime?      @map("completed_at")
  releaseRun       ReleaseRun     @relation(fields: [releaseRunId], references: [id])
  decisionRecord   DecisionRecord @relation(fields: [decisionRecordId], references: [id])

  @@unique([decisionRecordId, continuationKey], map: "idx_release_dispatches_decision_continuation")
  @@index([status, claimExpiresAt, createdAt], map: "idx_release_dispatches_claim")
  @@index([releaseRunId, status], map: "idx_release_dispatches_run_status")
  @@map("release_dispatches")
}

// ─── Launch Tiers & Checklists ──────────────────────────────────────────────
// Moving a RoadmapItem to the LAUNCHING horizon requires picking a launch
// tier, which auto-attaches a checklist cloned from a workspace-scoped
// template. Mirrors the ScoringModel/ScoringModelMetric → OpportunityScore
// template-vs-instance pattern above: templates are editable named presets,
// checklists are frozen per-launch instances (with a JSON snapshot of the
// template at attach time) so later template edits/archival don't retroactively
// change an in-flight launch's checklist.
// See Claude/2026-07-21-compass-gtm-planning-design.md and
// Claude/2026-07-21-compass-gtm-roadmap-lifecycle-adr.md for design context.

model ChecklistTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// One of: TIER_1 | TIER_2 | TIER_3 (major / minor / silent launch)
  tier        String   @db.VarChar(20)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  /// One of: ACTIVE | ARCHIVED. Archived templates are hidden from
  /// set_launch_tier's auto-resolution but remain valid for any
  /// LaunchChecklist already created from them.
  status      String   @default("ACTIVE") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  workspace  Workspace               @relation(fields: [workspaceId], references: [id])
  items      ChecklistTemplateItem[]
  checklists LaunchChecklist[]

  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checklistTemplateId String  @map("checklist_template_id") @db.Uuid
  label               String  @db.VarChar(255)
  description         String? @db.Text
  order               Int     @default(0)

  checklistTemplate ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id])

  @@map("checklist_template_items")
}

model LaunchChecklist {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roadmapItemId       String   @unique @map("roadmap_item_id") @db.Uuid
  checklistTemplateId String   @map("checklist_template_id") @db.Uuid
  /// Denormalized copy of the template's tier at attach time — survives
  /// template edits/archival.
  tier                String   @db.VarChar(20)
  /// JSON-encoded (TEXT, not a Json column — matches the formula_snapshot
  /// convention in migration 019_scoring_models) snapshot of the template +
  /// its items at attach time, so historical checklists are self-describing
  /// even after the live template changes.
  templateSnapshot    String   @map("template_snapshot") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @map("updated_at")

  roadmapItem       RoadmapItem           @relation(fields: [roadmapItemId], references: [id])
  checklistTemplate ChecklistTemplate     @relation(fields: [checklistTemplateId], references: [id])
  items             LaunchChecklistItem[]

  @@map("launch_checklists")
}

model LaunchChecklistItem {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  launchChecklistId String    @map("launch_checklist_id") @db.Uuid
  label             String    @db.VarChar(255)
  description       String?   @db.Text
  /// Tri-state (not boolean) so a SKIPPED item doesn't falsely register as
  /// blocking a later launch-readiness gate. One of: PENDING | DONE | SKIPPED.
  status            String    @default("PENDING") @db.VarChar(20)
  order             Int       @default(0)
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @map("updated_at")

  launchChecklist LaunchChecklist @relation(fields: [launchChecklistId], references: [id])

  @@map("launch_checklist_items")
}

// ─── Squads ───────────────────────────────────────────────────────────────────

model Squad {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String        @map("workspace_id") @db.Uuid
  name          String        @db.VarChar(255)
  color         String        @default("#6366f1") @db.VarChar(50)
  createdAt     DateTime      @default(now()) @map("created_at")
  workspace     Workspace     @relation(fields: [workspaceId], references: [id])
  objectives    Objective[]
  opportunities Opportunity[]
  experiments   Experiment[]
  roadmapItems  RoadmapItem[]
  tasks         Task[]
  createdById   String?       @map("created_by_id") @db.Uuid
  updatedById   String?       @map("updated_by_id") @db.Uuid
  source        String        @default("UI") @map("source") @db.VarChar(20)

  @@map("squads")
}

// ─── Custom Fields ────────────────────────────────────────────────────────────

// ─── Shared Field Option Sets ────────────────────────────────────────────────
// Generalizes CustomFieldDefinition.options so multiple field definitions —
// across different objectTypes — can share one editable picklist instead of
// each holding an independent copy. Not specific to "Product Area": any
// workspace can create any number of named sets for any SELECT/MULTI_SELECT
// use case. ADR context: Products/Compass/Brainstorm — Product Area Shared
// Custom Field Options — 2026-09-16.md.

model SharedFieldOptionSet {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// Admin-facing label for pickers when attaching a field to this set,
  /// e.g. "Product Area". Purely descriptive — not a controlled vocabulary
  /// of set "kinds"; a workspace can create as many sets as it wants.
  name        String   @db.VarChar(255)
  /// Same shape as CustomFieldDefinition.options: JSON array of
  /// { label: string; value: string; color?: string }. This is the single
  /// source of truth for every CustomFieldDefinition that references this
  /// set via sharedOptionSetId.
  options     Json
  createdAt   DateTime @default(now()) @map("created_at")
  /// No @updatedAt — DSQL has no ON UPDATE triggers. Set explicitly in app code.
  updatedAt   DateTime @default(now()) @map("updated_at")

  workspace   Workspace               @relation(fields: [workspaceId], references: [id])
  fields      CustomFieldDefinition[]
  createdById String?                 @map("created_by_id") @db.Uuid
  updatedById String?                 @map("updated_by_id") @db.Uuid
  /// One of: UI | MCP
  source      String                  @default("UI") @map("source") @db.VarChar(20)

  @@unique([workspaceId, name])
  @@map("shared_field_option_sets")
}

model CustomFieldDefinition {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// One of: OPPORTUNITY | SOLUTION | EXPERIMENT | OBJECTIVE | KEY_RESULT | ROADMAP_ITEM | TASK
  objectType  String   @map("object_type") @db.VarChar(50)
  name        String   @db.VarChar(255)
  /// One of: TEXT | NUMBER | DATE | SELECT | MULTI_SELECT | URL | BOOLEAN
  fieldType   String   @map("field_type") @db.VarChar(50)
  /// For SELECT / MULTI_SELECT: JSON array of { label: string; value: string; color?: string }.
  /// Ignored when sharedOptionSetId is set (kept nullable rather than dropped,
  /// so existing/unreferenced definitions are completely unaffected). App code
  /// nulls this out when a definition adopts a shared set, so there is never a
  /// live definition with both a local options array and a sharedOptionSetId
  /// disagreeing with each other. On detach the set's current options are
  /// copied back down here — see lib/shared-field-options.ts.
  options     Json?
  /// Optional link to a SharedFieldOptionSet. Only valid when fieldType is
  /// SELECT or MULTI_SELECT — enforced in application code (see
  /// app/[orgSlug]/[workspaceSlug]/settings/actions.ts), not a DB constraint.
  /// When set, this field's effective options are sharedOptionSet.options,
  /// not the local `options` column above.
  sharedOptionSetId String? @map("shared_option_set_id") @db.Uuid
  required    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace       Workspace             @relation(fields: [workspaceId], references: [id])
  sharedOptionSet SharedFieldOptionSet? @relation(fields: [sharedOptionSetId], references: [id])
  values          CustomFieldValue[]
  createdById String?            @map("created_by_id") @db.Uuid
  updatedById String?            @map("updated_by_id") @db.Uuid
  source      String             @default("UI") @map("source") @db.VarChar(20)

  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fieldId   String   @map("field_id") @db.Uuid
  objectId  String   @map("object_id") @db.Uuid
  /// Flexible storage: string | number | boolean | string[] | null
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  field CustomFieldDefinition @relation(fields: [fieldId], references: [id])

  @@unique([fieldId, objectId])
  @@map("custom_field_values")
}

// ─── API Keys ─────────────────────────────────────────────────────────────────

model ApiKey {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  name             String    @db.VarChar(255)
  keyHash          String    @unique @map("key_hash") @db.VarChar(64)
  keyPrefix        String    @map("key_prefix") @db.VarChar(8)
  purpose          String?   @db.VarChar(30)
  agentId          String?   @map("agent_id") @db.Uuid
  scopeWorkspaceId String?   @map("scope_workspace_id") @db.Uuid
  scopeConversationId String? @map("scope_conversation_id") @db.Uuid
  scopeClaimId String? @map("scope_claim_id") @db.Uuid
  expiresAt        DateTime? @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id])

  @@index([keyPrefix])
  @@index([agentId])
  @@index([purpose, scopeWorkspaceId])
  @@map("api_keys")
}

// ─── Portal Auth (fully independent of User/Session/VerificationToken) ────────
// See ADR: Claude/compass-portal-auth-adr-2026-07-03.md
// Portal accounts/sessions are intentionally non-interoperable with Auth.js.
// Do not add a FK to User. Do not reuse authjs.session-token.

model PortalAccount {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.VarChar(255)
  name          String?  @db.VarChar(255)
  emailVerified DateTime @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")

  sessions      PortalSession[]
  feedbackItems FeedbackItem[]
  feedbackVotes FeedbackVote[]
  roadmapVotes  RoadmapVote[]
  externalComments CommentExternalAuthor[]
  embedVisitorSessions EmbedVisitorSession[]
  embedAuthHandoffs    EmbedAuthHandoff[]

  @@map("portal_accounts")
}

model PortalSession {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portalAccountId String        @map("portal_account_id") @db.Uuid
  tokenHash       String        @unique @map("token_hash") @db.VarChar(64)
  expiresAt       DateTime      @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  lastUsedAt      DateTime      @default(now()) @map("last_used_at")
  portalAccount   PortalAccount @relation(fields: [portalAccountId], references: [id])

  @@index([portalAccountId])
  @@map("portal_sessions")
}

// Magic-link verification tokens for portal signup/login.
// Deliberately a separate table from Auth.js's VerificationToken —
// same reason as everything else in this ADR: no shared code path.
model PortalVerificationToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.VarChar(255)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("portal_verification_tokens")
}

// ─── Feedback ─────────────────────────────────────────────────────────────────

model FeedbackItem {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String               @map("workspace_id") @db.Uuid
  opportunityId   String?              @map("opportunity_id") @db.Uuid
  title           String               @db.VarChar(255)
  description     String?              @db.Text
  type            String               @default("IDEA") @db.VarChar(50)
  submitterName   String?              @map("submitter_name") @db.VarChar(255)
  submitterEmail  String?              @map("submitter_email") @db.VarChar(255)
  portalAccountId String?              @map("portal_account_id") @db.Uuid
  status          String               @default("OPEN") @db.VarChar(50)
  voteCount       Int                  @default(0) @map("vote_count")
  tags            Json?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @default(now()) @map("updated_at")
  workspace       Workspace            @relation(fields: [workspaceId], references: [id])
  opportunity     Opportunity?         @relation(fields: [opportunityId], references: [id])
  portalAccount   PortalAccount?       @relation(fields: [portalAccountId], references: [id])
  votes           FeedbackVote[]
  roadmapItems    RoadmapItem[]
  elementAnchor   FeedbackElementAnchor?
  createdById     String?              @map("created_by_id") @db.Uuid
  updatedById     String?              @map("updated_by_id") @db.Uuid
  source          String               @default("UI") @map("source") @db.VarChar(20)
  attachments     FeedbackAttachment[]

  // The Feedback grid runs sorting, filtering and pagination in Postgres, so
  // every access path below is a real query shape, not speculation.
  //
  // These are applied to DSQL by prisma/migrations/033_feedback_grid_indexes,
  // run through /api/admin/migrate — NOT by `prisma db push`. DSQL builds
  // indexes ASYNCHRONOUSLY (`CREATE INDEX ASYNC` returns a job_id immediately
  // and the index is INVALID until the build finishes), so nothing here may
  // assume an index exists; these only make already-correct queries faster.
  //
  // NO `sort: Desc` BELOW, DELIBERATELY. Aurora DSQL's CREATE INDEX grammar has
  // no ASC/DESC per column — only `NULLS FIRST|LAST`. A `sort: Desc` here makes
  // Prisma emit `("vote_count" DESC)`, which DSQL rejects outright. It costs us
  // nothing: `workspaceId` is always pinned by an equality predicate, so the
  // remaining key columns can be walked backwards by a reverse index scan to
  // satisfy `ORDER BY vote_count DESC, created_at DESC`.
  //
  // No index on `title`/`description`: the search filter is `contains` →
  // `ILIKE '%x%'`, which cannot use a btree.
  @@index([workspaceId, voteCount, createdAt])
  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@index([workspaceId, createdAt])
  // relationMode = "prisma" means Prisma emits no FK constraint, so DSQL
  // creates no backing index for this column either.
  @@index([opportunityId])
  @@map("feedback")
}

/// A place that is allowed to submit embedded feedback: one prototype, or one
/// real site.
///
/// `artifactId` is the routing decision and it is a property of THIS row, not of
/// the request. Null means the source is a real application, and its submissions
/// become FeedbackItem rows on the workspace's feedback board. Set means the
/// source is an Artifact-backed prototype, and its submissions become Comment
/// rows with targetType=ARTIFACT so they land on the artifact the team is
/// already reviewing. A token cannot change that; the widget cannot ask for it.
///
/// Deliberately independent of Artifact so a production site — which has no
/// artifact and never will — can hold a long-lived credential and rotate it
/// without a redeploy.
model FeedbackSource {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String                @map("workspace_id") @db.Uuid
  artifactId     String?               @map("artifact_id") @db.Uuid
  name           String                @db.VarChar(255)
  /// JSON array of EXACT origins ("https://app.example.com"). Never a pattern,
  /// never "*". An empty array accepts nothing, which is the safe failure.
  allowedOrigins Json                  @map("allowed_origins")
  enabled        Boolean               @default(true)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @default(now()) @map("updated_at")
  createdById    String?               @map("created_by_id") @db.Uuid
  workspace      Workspace             @relation(fields: [workspaceId], references: [id])
  artifact       Artifact?             @relation(fields: [artifactId], references: [id])
  tokens         FeedbackSourceToken[]
  visitorSessions EmbedVisitorSession[]
  authHandoffs    EmbedAuthHandoff[]

  @@index([workspaceId, enabled], map: "idx_feedback_sources_workspace")
  @@index([artifactId], map: "idx_feedback_sources_artifact")
  @@map("feedback_sources")
}

/// A rotatable credential for one FeedbackSource. Split from the source so a
/// deployed site can be issued a new token and have the old one revoked without
/// the source — and therefore the origin allowlist and the comments already
/// filed against it — being recreated.
///
/// `expiresAt` is NULLABLE, following ApiKey.expiresAt (which is also nullable).
/// A production site's embed token has no natural expiry date, and a token that
/// silently stops working is a worse failure than one that has to be revoked
/// deliberately. Revocation is the intended kill switch.
///
/// The four `*Window*`/`*Count*` columns are a compare-and-set rate limiter in
/// the shape lib/research-session.ts already uses: a one-minute window stamp and
/// a counter, advanced by a conditional updateMany so two concurrent requests
/// cannot both believe they were first.
model FeedbackSourceToken {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackSourceId String         @map("feedback_source_id") @db.Uuid
  tokenHash        String         @unique(map: "idx_feedback_source_tokens_hash") @map("token_hash") @db.VarChar(64)
  tokenPrefix      String         @map("token_prefix") @db.VarChar(16)
  label            String?        @db.VarChar(255)
  expiresAt        DateTime?      @map("expires_at")
  revokedAt        DateTime?      @map("revoked_at")
  lastUsedAt       DateTime?      @map("last_used_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  createdById      String?        @map("created_by_id") @db.Uuid
  readWindowAt     DateTime?      @map("read_window_at")
  readCount        Int?           @map("read_count")
  submitWindowAt   DateTime?      @map("submit_window_at")
  submitCount      Int?           @map("submit_count")
  feedbackSource   FeedbackSource @relation(fields: [feedbackSourceId], references: [id])

  @@index([feedbackSourceId, revokedAt], map: "idx_feedback_source_tokens_source")
  @@map("feedback_source_tokens")
}

/// The identity a widget visitor presents when submitting, scoped to exactly one
/// FeedbackSource.
///
/// NOT a PortalSession, and deliberately not interchangeable with one. A visitor
/// signs in through the normal portal magic link, but what the widget receives is
/// this instead of the portal session token — because the widget's token ends up
/// in the JavaScript of a page Compass does not control, and a PortalSession
/// token would additionally authenticate that person to the roadmap and feedback
/// portal for 30 days. This authorizes one thing: commenting through one source.
///
/// `expiresAt` is NOT NULL, which is the opposite choice from
/// FeedbackSourceToken.expiresAt. That token is held by an operator's deployment
/// and revocation is its kill switch; this one is held by a third party's page,
/// so expiry has to be intrinsic rather than administrative.
model EmbedVisitorSession {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackSourceId String         @map("feedback_source_id") @db.Uuid
  portalAccountId  String         @map("portal_account_id") @db.Uuid
  tokenHash        String         @unique(map: "idx_embed_visitor_sessions_hash") @map("token_hash") @db.VarChar(64)
  expiresAt        DateTime       @map("expires_at")
  revokedAt        DateTime?      @map("revoked_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  lastUsedAt       DateTime?      @map("last_used_at")
  feedbackSource   FeedbackSource @relation(fields: [feedbackSourceId], references: [id])
  portalAccount    PortalAccount  @relation(fields: [portalAccountId], references: [id])

  @@index([feedbackSourceId, portalAccountId], map: "idx_embed_visitor_sessions_scope")
  @@map("embed_visitor_sessions")
}

/// One leg of the sign-in handoff: how a credential crosses from the first-party
/// popup, which holds the portal cookie, to the widget, which cannot receive it.
///
/// Knowledge of the nonce IS the credential, because the claim endpoint is
/// necessarily unauthenticated — a widget on someone else's origin has no cookie,
/// session, or header worth checking. What makes that a sound trade is that the
/// nonce is CSPRNG-drawn, only its digest is stored, the window is two minutes,
/// and a claim is single-use.
///
/// This row holds nothing claimable: it records that a nonce entitles its bearer
/// to a session for this account and source, and the token is MINTED AT CLAIM
/// TIME. The prior art this is ported from deposited the raw token instead, so
/// reading its table during the handoff window yielded a usable credential.
model EmbedAuthHandoff {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nonceHash        String         @unique(map: "idx_embed_auth_handoffs_nonce") @map("nonce_hash") @db.VarChar(64)
  feedbackSourceId String         @map("feedback_source_id") @db.Uuid
  portalAccountId  String         @map("portal_account_id") @db.Uuid
  expiresAt        DateTime       @map("expires_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  feedbackSource   FeedbackSource @relation(fields: [feedbackSourceId], references: [id])
  portalAccount    PortalAccount  @relation(fields: [portalAccountId], references: [id])

  @@index([expiresAt], map: "idx_embed_auth_handoffs_expiry")
  @@map("embed_auth_handoffs")
}

/// The FeedbackItem counterpart of CommentElementAnchor, for submissions from an
/// unbound (real-application) FeedbackSource.
///
/// It exists as a separate table rather than a shared one because a FeedbackItem
/// has no artifact — by definition, an unbound source has none — so there is no
/// `artifact_id` column to share and nothing for a polymorphic
/// `(targetType, targetId)` pair to buy. Created in Phase 1 so the schema does
/// not have to change when the unbound path is built; nothing writes it yet.
model FeedbackElementAnchor {
  feedbackItemId     String       @id @map("feedback_item_id") @db.Uuid
  feedbackSourceId   String       @map("feedback_source_id") @db.Uuid
  pageUrl            String       @map("page_url") @db.Text
  pagePath           String       @map("page_path") @db.Text
  elementSelector    String?      @map("element_selector") @db.Text
  elementFingerprint Json?        @map("element_fingerprint")
  /// Same meaning as CommentElementAnchor.screenshotUrl, kept identical so the
  /// two anchor shapes stay interchangeable when the unbound path writes here.
  screenshotUrl      String?      @map("screenshot_url") @db.Text
  feedbackItem       FeedbackItem @relation(fields: [feedbackItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([feedbackSourceId, pageUrl], map: "idx_feedback_element_anchors_source_page")
  @@map("feedback_element_anchors")
}

model FeedbackAttachment {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackItemId String       @map("feedback_item_id") @db.Uuid
  url            String       @db.Text
  filename       String       @db.VarChar(255)
  fileType       String       @map("file_type") @db.VarChar(100)
  fileSize       Int          @map("file_size")
  createdAt      DateTime     @default(now()) @map("created_at")
  feedbackItem   FeedbackItem @relation(fields: [feedbackItemId], references: [id])

  @@index([feedbackItemId])
  @@map("feedback_attachment")
}

model FeedbackVote {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackId      String         @map("feedback_id") @db.Uuid
  voterEmail      String         @map("voter_email") @db.VarChar(255)
  portalAccountId String?        @map("portal_account_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  feedbackItem    FeedbackItem   @relation(fields: [feedbackId], references: [id])
  portalAccount   PortalAccount? @relation(fields: [portalAccountId], references: [id])

  @@unique([feedbackId, voterEmail])
  @@map("feedback_votes")
}

// ─── Docs ─────────────────────────────────────────────────────────────────────

model Doc {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String       @map("workspace_id") @db.Uuid
  parentId      String?      @map("parent_id") @db.Uuid
  title         String       @db.VarChar(255)
  content       String?      @db.Text
  metadata      Json?        @map("metadata") @db.Json
  icon          String?      @db.VarChar(50)
  sortOrder     Int          @default(0) @map("sort_order")
  /// UUID of the RoadmapItem this doc is a Positioning & Messaging Brief for,
  /// 1:1 (unique). Null for ordinary docs. See docType.
  roadmapItemId String?      @unique @map("roadmap_item_id") @db.Uuid
  /// One of: STANDARD | GTM_POSITIONING_BRIEF. Drives whether create_doc
  /// auto-fills GTM_POSITIONING_BRIEF_TEMPLATE and whether roadmapItemId is
  /// meaningful.
  docType       String       @default("STANDARD") @map("doc_type") @db.VarChar(50)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @map("updated_at")
  workspace     Workspace    @relation(fields: [workspaceId], references: [id])
  parent        Doc?         @relation("DocParent", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children      Doc[]        @relation("DocParent")
  roadmapItem   RoadmapItem? @relation(fields: [roadmapItemId], references: [id])
  createdById   String?      @map("created_by_id") @db.Uuid
  updatedById   String?      @map("updated_by_id") @db.Uuid
  source        String       @default("UI") @map("source") @db.VarChar(20)
  versions      DocVersion[]
  comments      DocComment[]

  @@map("docs")
}

/// Inline anchored comment on a Doc (Google-Docs-style). Threads are exactly
/// one level deep: a root comment (parentId null) optionally carries an anchor
/// into the doc's plain-text projection; replies (parentId set) never carry an
/// anchor. Anchors are NEVER embedded in Doc.content -- the markdown stays
/// untouched. The highlight is resolved at render time (see
/// lib/comment-anchor.ts + components/docs/comment-highlight-extension.ts).
/// No relationMode cascade on DSQL -- deleting a root must deleteMany its
/// replies first, and deleteDoc must bulk-delete this table's rows for a doc
/// before deleting the Doc row itself.
model DocComment {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  docId        String       @map("doc_id") @db.Uuid
  parentId     String?      @map("parent_id") @db.Uuid
  body         String       @db.Text
  status       String       @default("OPEN") @map("status") @db.VarChar(20)
  anchorText   String?      @map("anchor_text") @db.Text
  anchorPrefix String?      @map("anchor_prefix") @db.VarChar(100)
  anchorSuffix String?      @map("anchor_suffix") @db.VarChar(100)
  anchorStart  Int?         @map("anchor_start")
  anchorEnd    Int?         @map("anchor_end")
  authorName   String       @map("author_name") @db.VarChar(255)
  authorId     String?      @map("author_id") @db.Uuid
  authorType   String       @default("HUMAN") @map("author_type") @db.VarChar(20)
  source       String       @default("UI") @map("source") @db.VarChar(20)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @map("updated_at")
  doc          Doc          @relation(fields: [docId], references: [id])
  parent       DocComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replies      DocComment[] @relation("CommentReplies")

  @@index([docId, status])
  @@map("doc_comments")
}

/// Point-in-time snapshot of a Doc's content, taken automatically right before
/// an overwriting save (coalesced -- see lib/doc-versions.ts) or explicitly via
/// a "named" manual snapshot (label set, always written, never coalesced).
/// Insert-only: rows are never updated, only created and (on doc deletion)
/// bulk-deleted. No relationMode cascade on DSQL -- deleteDoc must delete
/// this table's rows for a doc before deleting the Doc row itself.
model DocVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  docId         String   @map("doc_id") @db.Uuid
  title         String   @db.VarChar(255)
  content       String?  @db.Text
  metadata      Json?    @db.Json
  icon          String?  @db.VarChar(50)
  /// Set only on manual "named" snapshots (bypasses coalescing). Null for
  /// ordinary auto-snapshots taken before an overwriting save.
  label         String?  @db.VarChar(100)
  createdById   String?  @map("created_by_id") @db.Uuid
  createdByName String?  @map("created_by_name") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  doc           Doc      @relation(fields: [docId], references: [id])

  @@index([docId, createdAt])
  @@map("doc_versions")
}

/// Stable identity for a prototype or external deliverable. Content lives in
/// immutable ArtifactRevision rows; currentRevisionId advances explicitly.
model Artifact {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String             @map("workspace_id") @db.Uuid
  title             String             @db.VarChar(255)
  description       String?            @db.Text
  /// HTML_UPLOAD | EXTERNAL_LINK
  sourceType        String             @map("source_type") @db.VarChar(30)
  /// ACTIVE | ARCHIVED
  status            String             @default("ACTIVE") @db.VarChar(20)
  currentRevisionId String?            @map("current_revision_id") @db.Uuid
  createdById       String?            @map("created_by_id") @db.Uuid
  updatedById       String?            @map("updated_by_id") @db.Uuid
  source            String             @default("UI") @db.VarChar(20)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @default(now()) @map("updated_at")
  workspace         Workspace          @relation(fields: [workspaceId], references: [id])
  revisions         ArtifactRevision[] @relation("ArtifactRevisions")
  currentRevision   ArtifactRevision?  @relation("CurrentArtifactRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  links             ArtifactLink[]
  researchStudies   ResearchStudy[]
  feedbackSources   FeedbackSource[]

  @@index([workspaceId, status, updatedAt])
  @@map("artifacts")
}

/// Insert-only Artifact content revision. Exactly one of blobPathname or
/// externalUrl is populated according to the parent Artifact.sourceType.
model ArtifactRevision {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artifactId     String     @map("artifact_id") @db.Uuid
  revisionNumber Int        @map("revision_number")
  blobPathname   String?    @map("blob_pathname") @db.Text
  filename       String?    @db.VarChar(255)
  mimeType       String?    @map("mime_type") @db.VarChar(100)
  byteSize       Int?       @map("byte_size")
  sha256         String?    @db.VarChar(64)
  externalUrl    String?    @map("external_url") @db.Text
  createdById    String?    @map("created_by_id") @db.Uuid
  source         String     @default("UI") @db.VarChar(20)
  createdAt      DateTime   @default(now()) @map("created_at")
  artifact       Artifact   @relation("ArtifactRevisions", fields: [artifactId], references: [id])
  currentFor     Artifact[] @relation("CurrentArtifactRevision")

  @@unique([artifactId, revisionNumber])
  @@index([artifactId, createdAt])
  @@map("artifact_revisions")
}

model ArtifactLink {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  artifactId  String   @map("artifact_id") @db.Uuid
  /// One of: SOLUTION | REVIEW_REQUEST. REVIEW_REQUEST links are restricted to
  /// requests with gateType TRACKED_DECISION and are live supporting material,
  /// not frozen review evidence -- see ADR-0010 and lib/artifacts.ts.
  linkedType  String   @map("linked_type") @db.VarChar(30)
  linkedId    String   @map("linked_id") @db.Uuid
  createdById String?  @map("created_by_id") @db.Uuid
  source      String   @default("UI") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  artifact    Artifact @relation(fields: [artifactId], references: [id])

  @@unique([artifactId, linkedType, linkedId])
  @@index([workspaceId, linkedType, linkedId])
  @@map("artifact_links")
}

/// Durable outbox for private Blob deletion. Rows are written before revision
/// metadata is removed and deleted only after Blob deletion succeeds.
model ArtifactBlobCleanup {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blobPathname String   @unique @map("blob_pathname") @db.Text
  reason       String   @db.VarChar(50)
  attempts     Int      @default(0)
  lastError    String?  @map("last_error") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  @@index([createdAt])
  @@map("artifact_blob_cleanups")
}

// ─── Canvas Viewer ────────────────────────────────────────────────────────────
// Phase 1 (this model ships now, unpopulated — no drag-to-pin UI yet, see
// Claude/compass-canvas-viewer-design-2026-07-21.md §8). A row only ever
// exists once a user explicitly pins a node's position; pinned defaults true
// so the flag is ready for a future unpin-as-update path instead of forcing
// delete/recreate races. Phase 2 requirement (not yet implemented): every
// hard-delete path for a pinnable entity (deleteObjective, deleteKeyResult)
// must delete its CanvasNodePosition row first, following the deleteSquad
// no-cascade-cleanup precedent — moot in Phase 1 since no row can exist yet.

model CanvasNodePosition {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  /// One of: OBJECTIVE | KEY_RESULT | OPPORTUNITY | SOLUTION | ASSUMPTION |
  /// EXPERIMENT | ROADMAP_ITEM — see CanvasEntityType in lib/types.ts. No
  /// writer exists yet (drag-to-pin UI is still deferred), so this table
  /// stays empty in practice, but every entity type is queryable already.
  entityType  String    @map("entity_type") @db.VarChar(50)
  entityId    String    @map("entity_id") @db.Uuid
  x           Float
  y           Float
  pinned      Boolean   @default(true)
  updatedAt   DateTime  @default(now()) @map("updated_at")
  updatedById String?   @map("updated_by_id") @db.Uuid

  @@unique([workspaceId, entityType, entityId])
  @@map("canvas_node_positions")
}

// ─── Evidence ─────────────────────────────────────────────────────────────────

model Evidence {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String       @map("workspace_id") @db.Uuid
  /// One of: interview | feedback | support_ticket | experiment_result | analytics
  sourceType    String       @map("source_type") @db.VarChar(50)
  excerpt       String       @db.Text
  sourceUrl     String?      @map("source_url") @db.VarChar(2048)
  /// One of: high | medium | low
  confidence    String       @default("medium") @db.VarChar(50)
  opportunityId String?      @map("opportunity_id") @db.Uuid
  solutionId    String?      @map("solution_id") @db.Uuid
  assumptionId  String?      @map("assumption_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @map("updated_at")

  /// ADR-0012 step 5 provenance. Which ResearchSynthesis proposed this evidence;
  /// null for everything add_evidence creates and for every pre-052 row.
  researchSynthesisId String? @map("research_synthesis_id") @db.Uuid
  /// Deterministic idempotency key: researchFindingKey(synthesisId, finding) in
  /// lib/research-evidence-promotion.ts. Unique per workspace (see @@unique
  /// below), so re-promoting one finding converges on one row.
  findingKey          String? @map("finding_key") @db.Char(64)

  workspace         Workspace              @relation(fields: [workspaceId], references: [id])
  opportunity       Opportunity?           @relation(fields: [opportunityId], references: [id])
  solution          Solution?              @relation(fields: [solutionId], references: [id])
  assumption        Assumption?            @relation(fields: [assumptionId], references: [id])
  researchSynthesis ResearchSynthesis?     @relation(fields: [researchSynthesisId], references: [id])
  researchSources   EvidenceResearchSource[]

  /// Workspace-scoped rather than global on purpose: a global unique would let a
  /// write in one workspace fail because of a row in another that the caller
  /// cannot see. NULLs are distinct, so unpromoted rows are unconstrained.
  @@unique([workspaceId, findingKey], map: "idx_evidence_workspace_finding_key")
  @@index([researchSynthesisId], map: "idx_evidence_research_synthesis")
  @@map("evidence")
}

/// The exact saved sources behind one promoted finding (ADR-0012 step 5).
///
/// A separate table rather than a column on Evidence because one finding
/// legitimately cites several quotes across several sessions.
///
/// REFERENTIAL INTEGRITY IS THE SERVICE LAYER'S JOB. Aurora DSQL has no foreign
/// keys and `relationMode = "prisma"` means the relations below are join hints,
/// not constraints — nothing in the database stops evidenceId or researchTurnId
/// from dangling. Every row here is written by promoteResearchFindingToEvidence
/// in lib/research-evidence-promotion.ts, in the same transaction as its Evidence
/// row, and only after each cited turn has been re-resolved inside the cited
/// synthesis's own study and re-checked verbatim against the saved turn text.
/// Deletion behaviour is likewise application-owned (ADR-0012, "Provenance rot").
model EvidenceResearchSource {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenceId           String    @map("evidence_id") @db.Uuid
  researchTurnId       String    @map("research_turn_id") @db.Uuid
  /// Reserved by ADR-0012 for findings that cite an attachment as well as a
  /// turn. Nothing writes it yet: synthesis quotes reference turns only, and
  /// lib/research-analysis.ts explicitly refuses to infer attachment contents. A
  /// future writer must validate it belongs to the cited turn before setting it.
  researchAttachmentId String?   @map("research_attachment_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")

  evidence           Evidence            @relation(fields: [evidenceId], references: [id])
  researchTurn       ResearchTurn        @relation(fields: [researchTurnId], references: [id])
  researchAttachment ResearchAttachment? @relation(fields: [researchAttachmentId], references: [id])

  @@unique([evidenceId, researchTurnId], map: "idx_evidence_research_sources_evidence_turn")
  @@index([researchTurnId], map: "idx_evidence_research_sources_turn")
  @@map("evidence_research_sources")
}

model RoadmapVote {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roadmapItemId   String         @map("roadmap_item_id") @db.Uuid
  voterEmail      String         @map("voter_email") @db.VarChar(255)
  voterName       String?        @map("voter_name") @db.VarChar(255)
  portalAccountId String?        @map("portal_account_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  roadmapItem     RoadmapItem    @relation(fields: [roadmapItemId], references: [id])
  portalAccount   PortalAccount? @relation(fields: [portalAccountId], references: [id])

  @@unique([roadmapItemId, voterEmail])
  @@map("roadmap_votes")
}

// ─── Tasks (Sprint Delivery + PM Initiative Tracking) ──────────────────────────
// Standalone top-level entity. Same status vocabulary serves two very different
// audiences — see TaskStatus in lib/types.ts for how a lightweight PM-tracker
// view and a full engineering Kanban/Scrum board both render off this one field.
// Links to other Compass objects are many-to-many via TaskLink (see below),
// NOT via nullable FK columns on this row — a Task can touch a Solution and a
// Doc and a KeyResult at once. See Claude/compass-task-tracker-design-2026-07-31.md.

model Task {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  squadId        String?   @map("squad_id") @db.Uuid
  parentTaskId   String?   @map("parent_task_id") @db.Uuid
  title          String    @db.VarChar(255)
  description    String?   @db.Text
  /// One of: BACKLOG | TODO | IN_PROGRESS | BLOCKED | IN_REVIEW | DONE | CANCELLED.
  /// BLOCKED is a first-class status column — not an orthogonal flag. Same
  /// vocabulary for full engineering delivery and lightweight PM initiative
  /// tracking — the UI, not the schema, decides which subset of statuses
  /// renders as board columns. See lib/types.ts TaskStatus.
  status         String    @default("TODO") @db.VarChar(50)
  /// One of: URGENT | HIGH | MEDIUM | LOW.
  priority       String    @default("MEDIUM") @db.VarChar(20)
  /// Nullable UUID of a WorkspaceMember's userId. No @relation — same
  /// reasoning as createdById/updatedById elsewhere in this schema: it's
  /// resolved against WorkspaceMember at the app layer, not joined by Prisma.
  assigneeUserId String?   @map("assignee_user_id") @db.Uuid
  assigneeAgentId String?  @map("assignee_agent_id") @db.Uuid
  /// Freeform owner name for PM-initiative tracking where the responsible party
  /// isn't a Compass WorkspaceMember (external stakeholder, exec, etc.). Either
  /// or both of assigneeUserId / ownerName may be set.
  ownerName      String?   @map("owner_name") @db.VarChar(255)
  storyPoints    Float?    @map("story_points")
  dueDate        DateTime? @map("due_date")
  /// Freeform sprint/iteration label (e.g. "Sprint 24", "2026-W31"). Reserved
  /// extension point for a future first-class Sprint entity.
  iteration      String?   @db.VarChar(100)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  workspace  Workspace  @relation(fields: [workspaceId], references: [id])
  squad      Squad?     @relation(fields: [squadId], references: [id])
  parentTask Task?      @relation("TaskParent", fields: [parentTaskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subtasks   Task[]     @relation("TaskParent")
  links      TaskLink[]
  releaseRunTasks ReleaseRunTask[]

  createdById String? @map("created_by_id") @db.Uuid
  updatedById String? @map("updated_by_id") @db.Uuid
  source      String  @default("UI") @map("source") @db.VarChar(20)

  @@index([workspaceId, status])
  @@index([squadId])
  @@index([parentTaskId])
  @@index([assigneeUserId])
  @@index([assigneeAgentId])
  @@map("tasks")
}

model Agent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid
  name String @db.VarChar(255)
  description String? @db.Text
  status String @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@index([ownerUserId])
  @@map("agents")
}

model AgentWorkspaceGrant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId String @map("agent_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  access String @db.VarChar(10)
  grantedByUserId String @map("granted_by_user_id") @db.Uuid
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@unique([agentId, workspaceId])
  @@index([workspaceId])
  @@map("agent_workspace_grants")
}

model AgentToolCall {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId String @map("agent_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  /// Polymorphic: an ApiKey.id when credentialType is "API_KEY", an
  /// OAuthToken.id when it is "OAUTH". Read `credentialType` first — a bare
  /// uuid join against api_keys will silently miss every OAuth-issued call.
  credentialId String @map("credential_id") @db.Uuid
  /// "API_KEY" | "OAUTH". The discriminator for credentialId, added by ADR 0015
  /// when an agent-bound OAuth token became a second source of agent identity.
  /// Nullable because DSQL rejects a DEFAULT on ALTER TABLE ADD COLUMN; rows
  /// predating migration 056 are backfilled to "API_KEY", which is what they
  /// all were. New rows get the value from Prisma's ORM-layer default.
  credentialType String? @default("API_KEY") @map("credential_type") @db.VarChar(10)
  toolName String @map("tool_name") @db.VarChar(100)
  workspaceId String? @map("workspace_id") @db.Uuid
  status String @default("STARTED") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  finishedAt DateTime? @map("finished_at")
  @@index([agentId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("agent_tool_calls")
}

// ─── Task Links (polymorphic many-to-many) ─────────────────────────────────
// Deliberately NOT shaped like Evidence (mutually-exclusive nullable FK
// columns, one parent per row) — a Task can relate to MULTIPLE objects across
// MULTIPLE types at once (e.g. one Task tied to both a Solution and a Doc).
// One row per (task, linked object) pair. linkedId carries no Prisma
// @relation because a single UUID column can't type-safely join into nine
// different target tables — same reasoning as CustomFieldValue.objectId
// above. Cross-type reads are resolved in application code (group links by
// linkedType, batch-fetch each type, stitch results back together), not via
// a single Prisma `include`.

model TaskLink {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  /// One of: OPPORTUNITY | SOLUTION | ROADMAP_ITEM | OBJECTIVE | KEY_RESULT |
  /// DOC | EXPERIMENT | FEEDBACK_ITEM | DECISION (ReviewRequest — see
  /// lib/task-tool-handlers.ts LINK_TARGET_MODEL comment for why DECISION is
  /// handled separately there). Squad is deliberately excluded — a Task's
  /// squad is its first-class owning Task.squadId column, not a generic link.
  linkedType  String   @map("linked_type") @db.VarChar(30)
  linkedId    String   @map("linked_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by_id") @db.Uuid
  source      String   @default("UI") @map("source") @db.VarChar(20)

  task Task @relation(fields: [taskId], references: [id])

  @@unique([taskId, linkedType, linkedId])
  @@index([linkedType, linkedId])
  @@map("task_links")
}

// ─── In-app agent runtime ────────────────────────────────────────────────────

/// Deployment-global singleton holding the current "golden" Vercel Sandbox
/// snapshot that the in-app agent runtime boots from, so each agent turn skips
/// `npm install` (~10s → ~200ms). Exactly one row, keyed by scope = "global".
/// Rebuilt via POST /api/admin/rebuild-agent-snapshot when the sandbox deps
/// change. See docs/decisions/0001-in-app-agent-architecture.md §3.
///
/// DSQL: no FKs; no @updatedAt trigger (updatedAt set explicitly in app code).
model AgentRuntimeConfig {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Singleton discriminator — always "global"; the @unique guarantees one row.
  scope            String    @unique @default("global") @db.VarChar(20)
  /// Vercel Sandbox snapshot id agent turns boot from; null until first build.
  goldenSnapshotId String?   @map("golden_snapshot_id") @db.VarChar(255)
  /// SHA-256 of the sandbox deps package.json at build time — detects drift.
  depsFingerprint  String?   @map("deps_fingerprint") @db.VarChar(64)
  /// When the current golden snapshot was built.
  snapshotBuiltAt  DateTime? @map("snapshot_built_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @map("updated_at")

  @@map("agent_runtime_config")
}

// ─── In-app agent conversations ──────────────────────────────────────────────

/// A chat conversation between a user and the in-app agent, scoped to one
/// workspace. History + per-turn usage live in AgentMessage. Access is gated
/// by workspace membership + ownership in the session-authed turn route
/// (not via MCP). See docs/decisions/0001-in-app-agent-architecture.md Phase 3.
/// DSQL: no FKs, no @updatedAt (set explicitly), no JSON columns.
model AgentConversation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String?  @db.VarChar(255)
  interviewProcessingJson String? @map("interview_processing_json") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
  messages  AgentMessage[]

  @@index([workspaceId, userId])
  @@map("agent_conversations")
}

/// One message in an AgentConversation. `role` is "user" | "assistant".
/// Assistant rows also carry usage/cost for the turn. The raw structured event
/// trace, if kept, is stored JSON-encoded as TEXT (formula_snapshot convention)
/// — never a JSON column (DSQL).
model AgentMessage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String   @db.VarChar(20)
  content        String   @db.Text
  /// Usage/cost (assistant turns only; null for user messages).
  model          String?  @db.VarChar(100)
  inputTokens    Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  numTurns       Int?     @map("num_turns")
  costUsd        Float?   @map("cost_usd")
  durationMs     Int?     @map("duration_ms")
  /// Exact JSON-encoded pack IDs, versions, source commits, digests and enabled
  /// skills used for this assistant turn. TEXT keeps the schema DSQL-safe.
  packProvenance String?  @map("pack_provenance") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AgentConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

// ─── Declarative agent capability packs ─────────────────────────────────────

model CapabilityPack {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  packId      String   @map("pack_id") @db.VarChar(120)
  sourceKey   String   @map("source_key") @db.VarChar(64)
  displayName String   @map("display_name") @db.VarChar(120)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  versions    CapabilityPackVersion[]
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, packId, sourceKey], map: "idx_capability_packs_workspace_pack_source")
  @@map("capability_packs")
}

model CapabilityPackVersion {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  capabilityPackId      String   @map("capability_pack_id") @db.Uuid
  semanticVersion       String   @map("semantic_version") @db.VarChar(80)
  sourceRepository      String   @map("source_repository") @db.Text
  sourceCommit          String   @map("source_commit") @db.VarChar(40)
  sourcePath            String   @map("source_path") @db.Text
  artifactSha256        String   @map("artifact_sha256") @db.VarChar(64)
  artifactPathname      String   @map("artifact_pathname") @db.Text
  sdkCompatibility      String   @map("sdk_compatibility") @db.VarChar(120)
  manifestJson          String   @map("manifest_json") @db.Text
  validationStatus      String   @default("VALID") @map("validation_status") @db.VarChar(20)
  validationMessage     String?  @map("validation_message") @db.Text
  createdById           String   @map("created_by_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  capabilityPack        CapabilityPack @relation(fields: [capabilityPackId], references: [id])
  workspaceAttachments  WorkspaceCapabilityPack[]

  @@unique([capabilityPackId, semanticVersion, sourceCommit], map: "idx_capability_pack_versions_identity")
  @@index([artifactSha256], map: "idx_capability_pack_versions_digest")
  @@map("capability_pack_versions")
}

model WorkspaceCapabilityPack {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId             String   @map("workspace_id") @db.Uuid
  capabilityPackId        String   @map("capability_pack_id") @db.Uuid
  capabilityPackVersionId String   @map("capability_pack_version_id") @db.Uuid
  enabledSkillIds         String   @map("enabled_skill_ids") @db.Text
  enabled                 Boolean  @default(true)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @default(now()) @map("updated_at")
  workspace               Workspace @relation(fields: [workspaceId], references: [id])
  capabilityPackVersion   CapabilityPackVersion @relation(fields: [capabilityPackVersionId], references: [id])

  @@unique([workspaceId, capabilityPackId], map: "idx_workspace_capability_packs_workspace_pack")
  @@index([workspaceId, enabled], map: "idx_workspace_capability_packs_enabled")
  @@index([capabilityPackVersionId], map: "idx_workspace_capability_packs_version")
  @@map("workspace_capability_packs")
}

/// Append-only audit trail of agent-initiated mutation tool calls (ADR 0001,
/// Phase 5). One row per mutating MCP tool the agent invoked on a user's
/// behalf. DSQL: no FKs; TEXT for the JSON-encoded args summary; no @updatedAt
/// (append-only).
model AgentAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  conversationId String?  @map("conversation_id") @db.Uuid
  toolName       String   @map("tool_name") @db.VarChar(100)
  /// JSON-encoded, truncated summary of the tool input (TEXT, not a JSON column).
  argsSummary    String?  @map("args_summary") @db.Text
  packProvenance String?  @map("pack_provenance") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@map("agent_audit_log")
}

// ─── OAuth authorization server (MCP) ─────────────────────────────────────────
// Compass is its own OAuth 2.1 authorization server for its MCP endpoint —
// issuer, resource server and identity provider all on one origin. See
// docs/design/mcp-oauth-discovery.md.
//
// DSQL constraints applied throughout:
//   - UUID PKs via gen_random_uuid()
//   - No @updatedAt (no triggers on DSQL)
//   - No FK constraints (relationMode = "prisma"), and deliberately no Prisma
//     relation fields either: these tables are written by unauthenticated DCR
//     and by the token endpoint, both of which resolve ids explicitly. Same
//     shape as AgentAuditLog.
//   - redirectUris / grantTypes are Json, not Postgres arrays — the schema
//     already uses Json in several places and it sidesteps an array-type
//     question on DSQL.

/// One dynamically registered OAuth client (RFC 7591). DCR is the only
/// registration path, so every row here is dynamic and unverified — expect one
/// row per Geode install, all named "Agent Threads". `lastUsedAt` is what TTL
/// pruning keys off.
model OAuthClient {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId                    String    @unique(map: "idx_oauth_clients_client_id") @map("client_id") @db.VarChar(64)
  /// Null for public clients, which is every client today (loopback clients
  /// cannot hold a secret; Geode registers token_endpoint_auth_method "none").
  clientSecretHash            String?   @map("client_secret_hash") @db.VarChar(64)
  clientName                  String    @map("client_name") @db.VarChar(255)
  /// JSON array of registered redirect URIs. Matched by lib/oauth/redirect-uri.ts.
  redirectUris                Json      @map("redirect_uris")
  /// JSON array of granted grant types, e.g. ["authorization_code","refresh_token"].
  grantTypes                  Json      @map("grant_types")
  scope                       String    @db.VarChar(255)
  tokenEndpointAuthMethod     String    @map("token_endpoint_auth_method") @db.VarChar(30)
  logoUri                     String?   @map("logo_uri") @db.Text
  clientUri                   String?   @map("client_uri") @db.Text
  softwareId                  String?   @map("software_id") @db.VarChar(255)
  registrationAccessTokenHash String?   @map("registration_access_token_hash") @db.VarChar(64)
  createdAt                   DateTime  @default(now()) @map("created_at")
  lastUsedAt                  DateTime? @map("last_used_at")

  @@index([lastUsedAt], map: "idx_oauth_clients_last_used")
  @@map("oauth_clients")
}

/// A single-use authorization code, 60 s TTL. Consumed atomically with a
/// conditional updateMany on (codeHash, consumedAt: null) — never read-then-write.
model OAuthAuthorizationCode {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeHash            String    @unique(map: "idx_oauth_authorization_codes_hash") @map("code_hash") @db.VarChar(64)
  clientId            String    @map("client_id") @db.VarChar(64)
  userId              String    @map("user_id") @db.Uuid
  redirectUri         String    @map("redirect_uri") @db.Text
  codeChallenge       String    @map("code_challenge") @db.VarChar(128)
  codeChallengeMethod String    @map("code_challenge_method") @db.VarChar(10)
  scope               String    @db.VarChar(255)
  /// RFC 8707 audience. Defaulted to the canonical MCP resource URI when the
  /// client omits `resource`, which the Geode broker and mcp-remote both do.
  resource            String    @db.Text
  /// "AGENT" | "USER" (ADR 0015). Explicit rather than inferred from
  /// `agentId IS NULL`, because a null agentId must not be ambiguous between
  /// "the user elected the admin override" and "this row predates agent
  /// binding". Read as a closed two-value parser: only exact "AGENT" and
  /// "USER" are accepted; null or unknown values fail closed. Nullable in the
  /// database (DSQL rejects a DEFAULT on ALTER TABLE ADD COLUMN); migration 056
  /// backfills legacy rows to "USER".
  authorizationMode   String?   @default("USER") @map("authorization_mode") @db.VarChar(10)
  /// Non-null iff authorizationMode is "AGENT". An Agent.id owned by userId —
  /// re-validated at every use, never trusted from issuance.
  agentId             String?   @map("agent_id") @db.Uuid
  expiresAt           DateTime  @map("expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([expiresAt], map: "idx_oauth_authorization_codes_expires")
  @@map("oauth_authorization_codes")
}

/// An issued access or refresh token, stored only as a SHA-256 hash.
/// `familyId` + `parentTokenId` carry refresh-rotation lineage so replay of a
/// rotated refresh token can revoke the whole family (phase 2).
model OAuthToken {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash        String    @unique(map: "idx_oauth_tokens_hash") @map("token_hash") @db.VarChar(64)
  /// "ACCESS" | "REFRESH" — a VarChar, matching every other status-like column
  /// in this schema (Prisma enums are not used here).
  type             String    @db.VarChar(10)
  clientId         String    @map("client_id") @db.VarChar(64)
  userId           String    @map("user_id") @db.Uuid
  scope            String    @db.VarChar(255)
  resource         String    @db.Text
  /// **Superseded by agentId + AgentWorkspaceGrant; always null** (ADR 0015).
  /// It was reserved for a workspace picker, but it is not a complete boundary
  /// as built — assertActorWorkspaceScope (lib/mcp-authz.ts) fires only for
  /// RESEARCH and AGENT_TURN, and assertWorkspaceAdmin / assertOrgMemberBySlug
  /// / assertOrgAdminBySlug never consult it — and it expresses one workspace
  /// with no access level where a grant set expresses many with per-workspace
  /// READ/WRITE. Grants strictly dominate. Kept only because dropping a column
  /// on DSQL helps nobody. Do not resurrect it.
  scopeWorkspaceId String?   @map("scope_workspace_id") @db.Uuid
  /// "AGENT" | "USER" (ADR 0015) — see OAuthAuthorizationCode.authorizationMode.
  /// This is the column validateOAuthAccessToken branches on to decide whether
  /// the token resolves to purpose "AGENT" or purpose "USER".
  authorizationMode String? @default("USER") @map("authorization_mode") @db.VarChar(10)
  /// Non-null iff authorizationMode is "AGENT". Carried forward across refresh
  /// rotation so a refresh can never silently widen an agent token into a user
  /// token.
  agentId          String?   @map("agent_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  familyId         String    @map("family_id") @db.Uuid
  parentTokenId    String?   @map("parent_token_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime? @map("last_used_at")

  @@index([agentId], map: "idx_oauth_tokens_agent")
  @@index([familyId], map: "idx_oauth_tokens_family")
  @@index([userId, clientId], map: "idx_oauth_tokens_user_client")
  @@index([expiresAt], map: "idx_oauth_tokens_expires")
  @@map("oauth_tokens")
}

/// A prior grant, so a returning user re-approving the same client with the
/// same scopes skips the consent screen.
model OAuthConsent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  clientId  String   @map("client_id") @db.VarChar(64)
  scope     String   @db.VarChar(255)
  /// "AGENT" | "USER" (ADR 0015) — see OAuthAuthorizationCode.authorizationMode.
  /// The unique key stays (userId, clientId): one connection has one binding,
  /// and the binding is data on the row rather than part of its identity, so a
  /// returning client replays the remembered binding instead of being offered a
  /// second one.
  authorizationMode String? @default("USER") @map("authorization_mode") @db.VarChar(10)
  /// Non-null iff authorizationMode is "AGENT".
  agentId   String?  @map("agent_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")

  @@unique([userId, clientId], map: "idx_oauth_consents_user_client")
  @@map("oauth_consents")
}

/// Immutable, secret-free evidence that a human explicitly authorized USER
/// credentials. Agent-bound authorizations use the existing per-call audit.
model OAuthAuthorizationEvent {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType            String   @map("event_type") @db.VarChar(50)
  source               String   @db.VarChar(30)
  authorizationCodeId  String   @unique(map: "idx_oauth_authorization_events_code") @map("authorization_code_id") @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  clientId             String   @map("client_id") @db.VarChar(64)
  clientNameSnapshot   String   @map("client_name_snapshot") @db.VarChar(255)
  redirectOrigin       String   @map("redirect_origin") @db.Text
  authorizationMode    String   @map("authorization_mode") @db.VarChar(10)
  agentId              String?  @map("agent_id") @db.Uuid
  scope                String   @db.VarChar(255)
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt], map: "idx_oauth_authorization_events_user_created")
  @@index([clientId, createdAt], map: "idx_oauth_authorization_events_client_created")
  @@map("oauth_authorization_events")
}

model AnalyticsConnection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  provider String @db.VarChar(40)
  projectId String @map("project_id") @db.VarChar(255)
  teamId String? @map("team_id") @db.VarChar(255)
  secretEncrypted String? @map("secret_encrypted") @db.Text
  generation Int @default(1)
  enabled Boolean @default(true)
  health String @default("CONNECTED") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@unique([workspaceId, provider], map: "idx_analytics_connection_workspace_provider")
  @@map("analytics_connections")
}

model MetricDefinition {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  currentRevisionId String @map("current_revision_id") @db.Uuid
  revision Int @default(1)
  archived Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@index([workspaceId, archived], map: "idx_metric_definition_workspace")
  @@map("metric_definitions")
}

model MetricRevision {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  metricId String @map("metric_id") @db.Uuid
  revision Int
  name String @db.VarChar(255)
  unit String @db.VarChar(80)
  provider String @db.VarChar(40)
  connectionId String? @map("connection_id") @db.Uuid
  queryJson String @map("query_json") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([metricId, revision], map: "idx_metric_revision_number")
  @@index([workspaceId, connectionId], map: "idx_metric_revision_workspace")
  @@map("metric_revisions")
}

model MetricBinding {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  metricId String @map("metric_id") @db.Uuid
  revisionId String @map("revision_id") @db.Uuid
  targetType String @map("target_type") @db.VarChar(30)
  targetId String @map("target_id") @db.Uuid
  baselineJson String @map("baseline_json") @db.Text
  followupJson String @map("followup_json") @db.Text
  targetValue Float? @map("target_value")
  active Boolean @default(true)
  lastError String? @map("last_error") @db.VarChar(80)
  lastAttemptAt DateTime? @map("last_attempt_at")
  lastAttemptId String? @map("last_attempt_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@index([workspaceId, targetType, targetId], map: "idx_metric_binding_target")
  @@index([workspaceId, metricId], map: "idx_metric_binding_metric")
  @@map("metric_bindings")
}

model MetricObservation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  bindingId String @map("binding_id") @db.Uuid
  revisionId String @map("revision_id") @db.Uuid
  refreshKey String @unique(map: "idx_metric_observation_refresh") @map("refresh_key") @db.VarChar(64)
  windowKind String @map("window_kind") @db.VarChar(12)
  snapshotJson String @map("snapshot_json") @db.Text
  dataJson String @map("data_json") @db.Text
  retrievedAt DateTime @default(now()) @map("retrieved_at")
  @@index([workspaceId, bindingId, retrievedAt], map: "idx_metric_observation_binding")
  @@map("metric_observations")
}

model WorkspaceActivationState {
  workspaceId String @id @map("workspace_id") @db.Uuid
  collectionStartedAt DateTime @map("collection_started_at")
  discoveryAt DateTime? @map("discovery_at")
  deliveryAt DateTime? @map("delivery_at")
  learningAt DateTime? @map("learning_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@map("workspace_activation_states")
}
