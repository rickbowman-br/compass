generator client {
  provider = "prisma-client-js"
}

model WorkspaceUpdateEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  revision    Int
  entityType  String   @map("entity_type") @db.VarChar(40)
  entityId    String   @map("entity_id") @db.Uuid
  groupType   String   @map("group_type") @db.VarChar(40)
  groupId     String   @map("group_id") @db.Uuid
  kind        String   @db.VarChar(40)
  actorType   String   @map("actor_type") @db.VarChar(20)
  actorId     String?  @map("actor_id") @db.Uuid
  before      String?  @db.VarChar(80)
  after       String?  @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at")
  @@unique([workspaceId, revision], map: "workspace_update_events_revision_key")
  @@map("workspace_update_events")
}

model WorkspaceUpdatesState {
  workspaceId String @id @map("workspace_id") @db.Uuid
  revision    Int @default(0)
  @@map("workspace_updates_state")
}

model WorkspaceUpdatesReadState {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String @map("workspace_id") @db.Uuid
  userId             String @map("user_id") @db.Uuid
  caughtUpRevision   Int @default(0) @map("caught_up_revision")
  previousRevision   Int? @map("previous_revision")
  version            String @db.Uuid
  baselineAt         DateTime @map("baseline_at")
  @@unique([workspaceId, userId], map: "workspace_updates_read_state_user_key")
  @@map("workspace_updates_read_state")
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

// ─── Auth.js / NextAuth models ───────────────────────────────────────────────
// DSQL constraints applied:
//  - UUID PKs via gen_random_uuid()
//  - No @updatedAt (DSQL does not support trigger-based auto-update)
//  - relationMode = "prisma" already set — no FK constraints generated

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?   @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now()) @map("created_at")

  organizationMembers OrganizationMember[]
  workspaceMembers    WorkspaceMember[]
  apiKeys             ApiKey[]
  agentConversations  AgentConversation[]
  authenticators      Authenticator[]

  @@map("users")
}

model Account {
  userId            String   @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id])
  type              String   @db.VarChar(50)
  provider          String   @db.VarChar(100)
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?  @db.VarChar(50)
  scope             String?
  id_token          String?
  session_state     String?  @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token") @db.VarChar(512)
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model PreviewAutomationSession {
  sessionToken String @id @map("session_token") @db.VarChar(512)
  runId        String @map("run_id") @db.Uuid

  @@map("preview_automation_sessions")
}

model PreviewAutomationRun {
  id                  String    @id @db.Uuid
  deploymentId        String    @map("deployment_id") @db.VarChar(255)
  orgId               String    @map("org_id") @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  isolatedWorkspaceId String    @map("isolated_workspace_id") @db.Uuid
  ownerUserId         String    @map("owner_user_id") @db.Uuid
  viewerUserId        String    @map("viewer_user_id") @db.Uuid
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  cleanedAt           DateTime? @map("cleaned_at")
  sessionNonce        String?   @map("session_nonce") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")

  @@map("preview_automation_runs")
}

model PreviewAutomationNonce {
  nonce     String   @id @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  expiresAt DateTime @map("expires_at")

  @@map("preview_automation_nonces")
}

model VerificationToken {
  identifier String   @db.VarChar(255)
  token      String   @db.VarChar(512)
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// Auth.js's Passkey/WebAuthn provider. @auth/prisma-adapter drives
// createAuthenticator/getAuthenticator/listAuthenticatorsByUserId/
// updateAuthenticatorCounter against this model by its Prisma field names
// (credentialID, userId, counter) once it exists — no adapter code changes
// needed. Own synthetic UUID `id` PK for house-style consistency; credentialID
// (the base64url WebAuthn credential id from the browser) is the adapter's
// actual lookup key and stays a separate unique column, matching Auth.js's
// documented model shape.
model Authenticator {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  credentialID         String   @unique @map("credential_id") @db.VarChar(512)
  userId               String   @map("user_id") @db.Uuid
  user                 User     @relation(fields: [userId], references: [id])
  providerAccountId    String   @map("provider_account_id") @db.VarChar(255)
  credentialPublicKey  String   @map("credential_public_key")
  counter              Int
  credentialDeviceType String   @map("credential_device_type") @db.VarChar(50)
  credentialBackedUp   Boolean  @map("credential_backed_up")
  transports           String?  @db.VarChar(255)
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("authenticators")
}

// ─── Multi-tenancy ────────────────────────────────────────────────────────────

model Organization {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String               @unique @db.VarChar(255)
  name          String               @db.VarChar(255)
  createdAt     DateTime             @default(now()) @map("created_at")
  workspaces    Workspace[]
  members       OrganizationMember[]
  scoringModels ScoringModel[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String       @default("MEMBER") @db.VarChar(50)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Workspace {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                  @map("organization_id") @db.Uuid
  slug                 String                  @db.VarChar(255)
  name                 String                  @db.VarChar(255)
  description          String?                 @db.Text
  feedbackEnabled      Boolean?                @default(false) @map("feedback_enabled")
  roadmapPublic        Boolean?                @default(false) @map("roadmap_public")
  // WIP limits for the NOW/NEXT roadmap columns — purely visual/advisory
  // (see docs/decisions/0005 and 0006, which retired the old runtime
  // enforcement machinery). Null means "no limit set"; there is
  // deliberately no default limit.
  nowLimit             Int?                    @map("now_limit")
  nextLimit            Int?                    @map("next_limit")
  portalAuthRequired   Boolean?                @default(false) @map("portal_auth_required")
  // Whether comments filed against this workspace's Artifacts may be READ
  // without a Compass session — the analogue of roadmapPublic for artifact
  // feedback. Submitting through an embedded widget is gated by the embed token
  // and origin allowlist and does NOT consult this flag; only the read path
  // does. Default off, so enabling an embed source never silently publishes an
  // existing internal review thread.
  artifactFeedbackPublic Boolean?              @default(false) @map("artifact_feedback_public")
  brandingPaletteId    String?                 @map("branding_palette_id") @db.VarChar(50)
  brandingPrimaryHex   String?                 @map("branding_primary_hex") @db.VarChar(7)
  brandingFontPresetId String?                 @map("branding_font_preset_id") @db.VarChar(50)
  brandingFontFamily   String?                 @map("branding_font_family") @db.VarChar(100)
  brandingLogoUrl      String?                 @map("branding_logo_url") @db.Text
  ssoEnabled           Boolean?                @default(false) @map("sso_enabled")
  // Gates the entire marketing-launch surface: launch tiers/checklists, the
  // LAUNCHING/LAUNCHED roadmap horizons, the roadmap-item panel's Launch
  // section, the roadmap card's launch chip/menu item, positioning briefs
  // (Doc.docType GTM_POSITIONING_BRIEF), and the related MCP tools. Default
  // off for every workspace — most teams don't run a marketing-launch
  // workflow and found the always-on surface noisy. See
  // Claude/2026-07-21-compass-gtm-planning-design.md for original context.
  launchWorkflowEnabled Boolean?               @default(false) @map("launch_workflow_enabled")
  // Ciphertext of the raw SSO shared secret (reversible AES-256-GCM
  // encryption via lib/crypto-secrets.ts, not a hash) — Compass must be
  // able to decrypt it to verify inbound customer-signed JWTs. The
  // plaintext is shown to the customer once, at generation time, and
  // never stored or re-displayed. Known v1 limitation: regenerating
  // overwrites the old secret outright — no rotation grace window.
  ssoSecretEncrypted   String?                 @map("sso_secret_encrypted") @db.Text
  // When the SSO secret was last (re)generated — separate from the
  // workspace's general `updatedAt` because that field is also bumped by
  // unrelated actions (e.g. branding updates), which would otherwise make
  // a "last rotated" timestamp in the settings UI lie.
  ssoSecretUpdatedAt   DateTime?               @map("sso_secret_updated_at")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @default(now()) @map("updated_at")
  organization         Organization            @relation(fields: [organizationId], references: [id])
  members              WorkspaceMember[]
  okrCycles            OKRCycle[]
  opportunities        Opportunity[]
  experiments          Experiment[]
  roadmapItems         RoadmapItem[]
  customFieldDefs      CustomFieldDefinition[]
  sharedFieldOptionSets SharedFieldOptionSet[]
  squads               Squad[]
  feedback             FeedbackItem[]
  docs                 Doc[]
  artifacts            Artifact[]
  scoringConfig        WorkspaceScoringConfig?
  evidence             Evidence[]
  canvasNodePositions  CanvasNodePosition[]
  checklistTemplates   ChecklistTemplate[]
  tasks                Task[]
  agentConversations   AgentConversation[]
  capabilityPacks      WorkspaceCapabilityPack[]
  installedCapabilityPacks CapabilityPack[]
  researchStudies      ResearchStudy[]
  researchAttachments  ResearchAttachment[]
  reviewRequests       ReviewRequest[]
  comments             Comment[]
  releaseRuns          ReleaseRun[]
  portfolioCapacityPlans PortfolioCapacityPlan[]
  feedbackSources      FeedbackSource[]

  @@unique([organizationId, slug])
  @@map("workspaces")
}

// ─── Capture / Research Studies ──────────────────────────────────────────────

model ResearchStudy {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String                     @map("workspace_id") @db.Uuid
  name              String                     @db.VarChar(255)
  goal              String                     @db.Text
  studyType         String                     @default("CUSTOMER_INTERVIEW") @map("study_type") @db.VarChar(30)
  guide             String                     @db.Text
  targetMinutes     Int                        @default(15) @map("target_minutes")
  appUrl            String?                    @map("app_url") @db.Text
  artifactId        String?                    @map("artifact_id") @db.Uuid
  shareTokenHash    String?                    @unique @map("share_token_hash") @db.VarChar(64)
  shareExpiresAt    DateTime?                  @map("share_expires_at")
  status            String                     @default("DRAFT") @db.VarChar(20)
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @default(now()) @map("updated_at")
  createdById       String?                    @map("created_by_id") @db.Uuid
  updatedById       String?                    @map("updated_by_id") @db.Uuid
  source            String                     @default("UI") @db.VarChar(20)
  workspace         Workspace                  @relation(fields: [workspaceId], references: [id])
  artifact          Artifact?                  @relation(fields: [artifactId], references: [id])
  sessions          ResearchSession[]
  syntheses         ResearchSynthesis[]
  participantTokens ResearchParticipantToken[]
  attachments       ResearchAttachment[]
  pmInterview       PMInterview?

  @@index([workspaceId, status])
  @@map("research_studies")
}

model ResearchParticipantToken {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studyId          String              @map("study_id") @db.Uuid
  tokenHash        String              @unique(map: "idx_research_participant_tokens_hash") @map("token_hash") @db.VarChar(64)
  kind             String              @default("PRIMARY") @db.VarChar(30)
  expiresAt        DateTime            @map("expires_at")
  revokedAt        DateTime?           @map("revoked_at")
  lastUsedAt       DateTime?           @map("last_used_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  createdById      String?             @map("created_by_id") @db.Uuid
  startWindowAt    DateTime?           @map("start_window_at")
  startCount       Int?                @map("start_count")
  responseWindowAt DateTime?           @map("response_window_at")
  responseCount    Int?                @map("response_count")
  agentWindowAt    DateTime?           @map("agent_window_at")
  agentCallCount   Int?                @map("agent_call_count")
  voiceWindowAt    DateTime?           @map("voice_window_at")
  voiceCount       Int?                @default(0) @map("voice_count")
  voiceDayAt       DateTime?           @map("voice_day_at")
  voiceDayCount    Int?                @default(0) @map("voice_day_count")
  study            ResearchStudy       @relation(fields: [studyId], references: [id])
  sessions         ResearchSession[]
  voiceCalls       ResearchVoiceCall[]

  @@index([studyId, kind, revokedAt], map: "idx_research_participant_tokens_study_kind")
  @@map("research_participant_tokens")
}

model ResearchSession {
  id                     String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studyId                String                    @map("study_id") @db.Uuid
  modality               String                    @default("CHAT") @db.VarChar(10)
  status                 String                    @default("PENDING") @db.VarChar(20)
  participantTokenId     String?                   @map("participant_token_id") @db.Uuid
  resumeTokenHash        String?                   @unique(map: "idx_research_sessions_resume_token") @map("resume_token_hash") @db.VarChar(64)
  participantName        String?                   @map("participant_name") @db.VarChar(255)
  participantEmail       String?                   @map("participant_email") @db.VarChar(255)
  summary                String?                   @db.Text
  audioUrl               String?                   @map("audio_url") @db.Text
  startedAt              DateTime?                 @map("started_at")
  lastActiveAt           DateTime?                 @map("last_active_at")
  completedAt            DateTime?                 @map("completed_at")
  endedReason            String?                   @map("ended_reason") @db.VarChar(50)
  nextSequence           Int?                      @map("next_sequence")
  activeRequestId        String?                   @map("active_request_id") @db.Uuid
  activeRequestExpiresAt DateTime?                 @map("active_request_expires_at")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @default(now()) @map("updated_at")
  study                  ResearchStudy             @relation(fields: [studyId], references: [id])
  participantToken       ResearchParticipantToken? @relation(fields: [participantTokenId], references: [id])
  turns                  ResearchTurn[]
  requests               ResearchRequest[]
  attachments            ResearchAttachment[]
  voiceEvents            ResearchVoiceEvent[]
  participantVoiceEvents ResearchParticipantVoiceEvent[]
  voiceCalls             ResearchVoiceCall[]
  voiceCommands          ResearchVoiceCommand[]
  voiceLeaseId           String?                   @map("voice_lease_id") @db.Uuid
  voiceLeaseExpiresAt    DateTime?                 @map("voice_lease_expires_at")
  voiceAttemptCount      Int?                      @default(0) @map("voice_attempt_count")
  voiceTurnCount         Int?                      @default(0) @map("voice_turn_count")
  voiceTranscriptChars   Int?                      @default(0) @map("voice_transcript_chars")
  pmInterview            PMInterview?

  @@index([studyId, status])
  @@index([participantTokenId, status], map: "idx_research_sessions_participant_token")
  @@map("research_sessions")
}

model PMInterview {
  id                        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId               String          @map("workspace_id") @db.Uuid
  studyId                   String          @unique(map: "idx_pm_interviews_study") @map("study_id") @db.Uuid
  sessionId                 String          @unique(map: "idx_pm_interviews_session") @map("session_id") @db.Uuid
  initiatingUserId          String          @map("initiating_user_id") @db.Uuid
  targetType                String          @map("target_type") @db.VarChar(30)
  targetId                  String          @map("target_id") @db.Uuid
  agentConversationId       String?         @unique(map: "idx_pm_interviews_agent_conversation") @map("agent_conversation_id") @db.Uuid
  contextSnapshotJson       String          @map("context_snapshot_json") @db.Text
  fieldBaselineJson         String          @map("field_baseline_json") @db.Text
  generationState           String          @default("NOT_STARTED") @map("generation_state") @db.VarChar(20)
  generationClaimId         String?         @map("generation_claim_id") @db.Uuid
  generationClaimedAt       DateTime?       @map("generation_claimed_at")
  generationFailureCode     String?         @map("generation_failure_code") @db.VarChar(50)
  sourceFingerprint         String?         @map("source_fingerprint") @db.VarChar(64)
  proposalJson              String?         @map("proposal_json") @db.Text
  disposition               String          @default("PENDING") @db.VarChar(20)
  receiptJson               String?         @map("receipt_json") @db.Text
  appliedAt                 DateTime?        @map("applied_at")
  dismissedAt               DateTime?        @map("dismissed_at")
  dispositionIdempotencyKey String?         @map("disposition_idempotency_key") @db.VarChar(128)
  retiredVoiceLeaseId       String?         @map("retired_voice_lease_id") @db.Uuid
  transitionReceiptJson     String?         @map("transition_receipt_json") @db.Text
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @default(now()) @map("updated_at")
  study                     ResearchStudy   @relation(fields: [studyId], references: [id])
  session                   ResearchSession @relation(fields: [sessionId], references: [id])

  @@index([workspaceId, createdAt], map: "idx_pm_interviews_workspace_created")
  @@index([workspaceId, targetType, targetId], map: "idx_pm_interviews_target")
  @@index([generationState, generationClaimedAt], map: "idx_pm_interviews_generation_claim")
  @@unique([id, dispositionIdempotencyKey], map: "idx_pm_interviews_disposition_key")
  @@map("pm_interviews")
}

model ResearchTurn {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String               @map("session_id") @db.Uuid
  role        String               @db.VarChar(20)
  content     String               @db.Text
  sequence    Int
  createdAt   DateTime             @default(now()) @map("created_at")
  session     ResearchSession      @relation(fields: [sessionId], references: [id])
  attachments ResearchAttachment[]

  participantVoiceEvent ResearchParticipantVoiceEvent?
  /// Promoted Evidence citing this turn (ADR-0012 step 5). No foreign key backs
  /// this, so deleting a turn silently orphans these rows — see the model.
  evidenceSources       EvidenceResearchSource[]

  @@unique([sessionId, sequence], map: "idx_research_turns_session_sequence")
  @@map("research_turns")
}

model ResearchRequest {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String          @map("session_id") @db.Uuid
  idempotencyKey    String          @map("idempotency_key") @db.VarChar(128)
  participantTurnId String?         @map("participant_turn_id") @db.Uuid
  interviewerTurnId String?         @map("interviewer_turn_id") @db.Uuid
  status            String          @default("PROCESSING") @db.VarChar(20)
  errorCode         String?         @map("error_code") @db.VarChar(50)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @map("updated_at")
  session           ResearchSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, idempotencyKey], map: "idx_research_requests_session_key")
  @@index([sessionId, createdAt], map: "idx_research_requests_session_created")
  @@map("research_requests")
}

model ResearchAttachment {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String          @map("workspace_id") @db.Uuid
  studyId        String          @map("study_id") @db.Uuid
  sessionId      String          @map("session_id") @db.Uuid
  turnId         String?         @map("turn_id") @db.Uuid
  kind           String          @db.VarChar(20)
  status         String          @default("PENDING") @db.VarChar(20)
  blobPathname   String          @unique(map: "idx_research_attachments_blob_pathname") @map("blob_pathname") @db.Text
  originalName   String          @map("original_name") @db.VarChar(255)
  mimeType       String          @map("mime_type") @db.VarChar(100)
  sizeBytes      Int             @map("size_bytes")
  sha256         String          @db.VarChar(64)
  idempotencyKey String          @map("idempotency_key") @db.VarChar(128)
  createdAt      DateTime        @default(now()) @map("created_at")
  readyAt        DateTime?       @map("ready_at")
  deletedAt      DateTime?       @map("deleted_at")
  workspace      Workspace       @relation(fields: [workspaceId], references: [id])
  study          ResearchStudy   @relation(fields: [studyId], references: [id])
  session        ResearchSession @relation(fields: [sessionId], references: [id])
  turn           ResearchTurn?   @relation(fields: [turnId], references: [id])
  /// Back-relation for the reserved EvidenceResearchSource.researchAttachmentId.
  evidenceSources EvidenceResearchSource[]

  @@unique([sessionId, idempotencyKey], map: "idx_research_attachments_session_key")
  @@index([sessionId, createdAt], map: "idx_research_attachments_session_created")
  @@index([turnId, createdAt], map: "idx_research_attachments_turn_created")
  @@index([workspaceId, status, createdAt], map: "idx_research_attachments_workspace_status")
  @@map("research_attachments")
}

model ResearchBlobCleanup {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  studyId       String    @map("study_id") @db.Uuid
  sessionId     String    @map("session_id") @db.Uuid
  attachmentId  String    @map("attachment_id") @db.Uuid
  blobPathname  String    @unique(map: "idx_research_blob_cleanups_pathname") @map("blob_pathname") @db.Text
  status        String    @default("PENDING") @db.VarChar(20)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @map("updated_at")
  completedAt   DateTime? @map("completed_at")

  @@index([workspaceId, status, nextAttemptAt], map: "idx_research_blob_cleanups_workspace_retry")
  @@map("research_blob_cleanups")
}

// Browser-reported transcript evidence, never provider-authenticated provenance.
model ResearchParticipantVoiceEvent {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String @map("workspace_id") @db.Uuid
  sessionId       String @map("session_id") @db.Uuid
  leaseId         String @map("lease_id") @db.Uuid
  clientEventId   String @map("client_event_id") @db.VarChar(255)
  reportedOrdinal Int @map("reported_ordinal")
  claimedSpeaker  String @map("claimed_speaker") @db.VarChar(20)
  content         String @db.Text
  turnId          String @unique(map: "idx_participant_voice_turn") @map("turn_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  session         ResearchSession @relation(fields: [sessionId], references: [id])
  turn            ResearchTurn @relation(fields: [turnId], references: [id])

  @@unique([sessionId, clientEventId], map: "idx_participant_voice_client_event")
  @@unique([sessionId, leaseId, reportedOrdinal], map: "idx_participant_voice_ordinal")
  @@index([workspaceId, sessionId], map: "idx_participant_voice_workspace_session")
  @@map("research_participant_voice_events")
}

