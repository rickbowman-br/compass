// ─── Human decision gates ───────────────────────────────────────────────────
// ReviewRequest is the mutable envelope. Revisions, options, decisions, and
// application receipts are append-only by service contract. UUID references
// are validated in application code because Aurora DSQL does not enforce FKs.

model ReviewRequest {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String           @map("workspace_id") @db.Uuid
  gateType           String           @map("gate_type") @db.VarChar(50)
  subjectType        String           @map("subject_type") @db.VarChar(50)
  subjectId          String           @map("subject_id") @db.Uuid
  state              String           @default("DRAFT") @db.VarChar(30)
  currentRevisionId  String?          @unique(map: "idx_review_requests_current_revision") @map("current_revision_id") @db.Uuid
  revisionCount      Int              @default(0) @map("revision_count")
  decisionCycle      Int              @default(1) @map("decision_cycle")
  reopenReason       String?          @map("reopen_reason") @db.Text
  reopenedById       String?          @map("reopened_by_id") @db.Uuid
  reconsidersDecisionId String?       @map("reconsiders_decision_id") @db.Uuid
  requestedById      String?          @map("requested_by_id") @db.Uuid
  /// The Agent that called request_decision, when the request was raised by
  /// an agent identity (McpActor.purpose === "AGENT") rather than a human.
  /// Distinct from requestedById, which is always the API key's owning user
  /// (an agent's owner) even for agent-raised requests -- see feedback
  /// f546cf13-e6a0-4213-8be9-0cfdebbf4ff7. Null for every pre-existing
  /// decision and for human-raised requests going forward.
  requestedByAgentId String?          @map("requested_by_agent_id") @db.Uuid
  assignedToId       String?          @map("assigned_to_id") @db.Uuid
  dueAt               DateTime?        @map("due_at")
  expiresAt           DateTime?        @map("expires_at")
  /// Set together to record "no action needed" on a DECIDED decision with no
  /// linked follow-up work -- the explicit close-out path for the
  /// "awaiting follow-through" lens (see docs/decisions and opportunity
  /// 80cb853b). All three are null until closed this way; noActionReason is
  /// required (non-empty) at write time by application code.
  noActionAt          DateTime?        @map("no_action_at")
  noActionById        String?          @map("no_action_by_id") @db.Uuid
  noActionReason      String?          @map("no_action_reason") @db.Text
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @default(now()) @map("updated_at")
  workspace           Workspace        @relation(fields: [workspaceId], references: [id])
  currentRevision     ReviewRevision?  @relation("CurrentReviewRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions           ReviewRevision[] @relation("RequestRevisions")
  decisions           DecisionRecord[]

  @@unique([workspaceId, gateType, subjectType, subjectId], map: "idx_review_requests_subject_gate")
  @@index([workspaceId, state], map: "idx_review_requests_workspace_state")
  @@map("review_requests")
}

model ReviewRevision {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId       String          @map("request_id") @db.Uuid
  revisionNumber  Int             @map("revision_number")
  sourceFingerprint String?       @map("source_fingerprint") @db.VarChar(64)
  fingerprint     String          @db.VarChar(64)
  title           String          @db.VarChar(255)
  summary         String?         @db.Text
  packetJson      String          @map("packet_json") @db.Text
  requiredRole    String          @default("ADMIN") @map("required_role") @db.VarChar(30)
  expiresAt       DateTime?       @map("expires_at")
  supersededAt    DateTime?       @map("superseded_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  request         ReviewRequest   @relation("RequestRevisions", fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentFor      ReviewRequest?  @relation("CurrentReviewRevision")
  options         ReviewOption[]
  decisions       DecisionRecord[]
  evidenceRefs    DecisionEvidenceRef[]

  @@unique([requestId, revisionNumber], map: "idx_review_revisions_request_number")
  @@unique([requestId, fingerprint], map: "idx_review_revisions_request_fingerprint")
  @@index([requestId, sourceFingerprint], map: "idx_review_revisions_request_source")
  @@map("review_revisions")
}

model DecisionEvidenceRef {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewRevisionId      String         @map("review_revision_id") @db.Uuid
  evidenceType          String         @map("evidence_type") @db.VarChar(80)
  authorityProvider     String         @map("authority_provider") @db.VarChar(30)
