  @@unique([reviewRevisionId, evidenceType, authorityRecordId], map: "idx_decision_evidence_refs_revision_authority")
  @@index([subjectType, subjectId, evidenceType], map: "idx_decision_evidence_refs_subject")
  @@map("decision_evidence_refs")
}

model ReviewOption {
